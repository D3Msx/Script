local function addToggle(parent, text, defaultValue, callback)
	local value = defaultValue == true

	local row = create("TextButton", {
		Name = tostring(text):gsub("%s+", "") .. "Toggle",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = "   " .. tostring(text),
		TextColor3 = Theme.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5,
		Parent = parent,
	})
	corner(row, 6)

	local track = create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(36, 20),
		BackgroundColor3 = value and Theme.Accent or Theme.Track,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = row,
	})
	corner(track, 10)

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = value and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Theme.Knob,
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = track,
	})
	corner(knob, 8)

	local control = {}

	local function render(animate)
		local targetColor = value and Theme.Accent or Theme.Track
		local targetPosition = value and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)

		if animate then
			tween(track, 0.18, { BackgroundColor3 = targetColor })
			tween(knob, 0.18, { Position = targetPosition })
		else
			track.BackgroundColor3 = targetColor
			knob.Position = targetPosition
		end
	end

	function control:Get()
		return value
	end

	function control:Set(newValue, fireCallback)
		value = newValue == true
		render(true)

		if fireCallback ~= false and callback then
			task.spawn(callback, value)
		end
	end

	bindHover(row, Theme.Control, Theme.ControlHover, Theme.ControlDown)
	connect(row.MouseButton1Click, function()
		control:Set(not value, true)
	end)

	control.Instance = row
	return control
end

local function addSlider(parent, text, minimum, maximum, defaultValue, callback)
	assert(type(minimum) == "number" and type(maximum) == "number", "Slider limits must be numbers")
	assert(maximum > minimum, "Slider maximum must be greater than minimum")

	local value = math.clamp(tonumber(defaultValue) or minimum, minimum, maximum)
	local dragging = false
	local hovering = false

	local holder = create("Frame", {
		Name = tostring(text):gsub("%s+", "") .. "Slider",
		Size = UDim2.new(1, 0, 0, 66),
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = parent,
	})
	corner(holder, 6)

	create("TextLabel", {
		Name = "Label",
		Position = UDim2.fromOffset(11, 7),
		Size = UDim2.new(1, -70, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = tostring(text),
		TextColor3 = Theme.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
		Parent = holder,
	})

	local valueLabel = create("TextLabel", {
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -11, 0, 7),
		Size = UDim2.fromOffset(50, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = tostring(value),
		TextColor3 = Theme.Accent,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 6,
		Parent = holder,
	})

	local bar = create("TextButton", {
		Name = "Bar",
		Position = UDim2.fromOffset(11, 42),
		Size = UDim2.new(1, -22, 0, 8),
		BackgroundColor3 = Theme.Track,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 6,
		Parent = holder,
	})
	corner(bar, 4)

	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = bar,
	})
	corner(fill, 4)

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Theme.Knob,
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = bar,
	})
	corner(knob, 7)
	stroke(knob, Theme.AccentDark, 0.25)

	local tooltip = create("TextLabel", {
		Name = "Tooltip",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0, 11, 0, 35),
		Size = UDim2.fromOffset(116, 32),
		BackgroundColor3 = Theme.Topbar,
		BackgroundTransparency = 0.14,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 10,
		TextTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = holder,
	})
	corner(tooltip, 6)
	stroke(tooltip, Theme.Separator, 0.2)

	local control = {}

	local function render(fireCallback)
		local alpha = (value - minimum) / (maximum - minimum)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = tostring(value)
		tooltip.Position = UDim2.new(alpha, 11 - (22 * alpha), 0, 35)
		tooltip.Text = string.format("%s: %d", tostring(text), value)

		if fireCallback and callback then
			task.spawn(callback, value)
		end
	end

	local function setFromX(x)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local nextValue = math.floor(minimum + ((maximum - minimum) * alpha) + 0.5)
		if nextValue ~= value then
			value = nextValue
			render(true)
		end
	end

	local function showTooltip()
		hovering = true
		tooltip.Visible = true
		tween(tooltip, 0.12, { TextTransparency = 0 })
	end

	local function hideTooltip()
		hovering = false
		if dragging then
			return
		end

		local animation = tween(tooltip, 0.12, { TextTransparency = 1 })
		animation.Completed:Once(function()
			if not hovering and not dragging then
				tooltip.Visible = false
			end
		end)
	end

	connect(holder.MouseEnter, showTooltip)
	connect(holder.MouseLeave, hideTooltip)

	connect(bar.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			showTooltip()
			setFromX(input.Position.X)
		end
	end)

	connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			setFromX(input.Position.X)
		end
	end)

	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if not hovering then
				hideTooltip()
			end
		end
	end)

	function control:Get()
		return value
	end

	function control:Set(newValue, fireCallback)
		value = math.clamp(math.floor((tonumber(newValue) or minimum) + 0.5), minimum, maximum)
		render(fireCallback ~= false)
	end

	control.Instance = holder
	render(false)
	return control
end

--// PUBLIC GUI API

local UI = {
	Categories = {},
	ActiveCategory = nil,
	ScreenGui = screenGui,
	Window = window,
	ToggleKey = DEFAULT_TOGGLE_KEY,
}

local menuOpen = true
local windowPosition = window.Position
local transitionId = 0

local function setMenuOpen(open)
	if menuOpen == open then
		return
	end

	menuOpen = open
	transitionId += 1
	local currentTransition = transitionId

	if open then
		window.Visible = true
		window.Position = UDim2.new(windowPosition.X.Scale, windowPosition.X.Offset, 1.25, 0)
		tween(window, 0.32, { Position = windowPosition })
	else
		windowPosition = window.Position
		local animation = tween(window, 0.28, {
			Position = UDim2.new(window.Position.X.Scale, window.Position.X.Offset, 1.25, 0),
		})
		animation.Completed:Once(function()
			if currentTransition == transitionId and not menuOpen then
				window.Visible = false
			end
		end)
	end
end

function UI:Show()
	setMenuOpen(true)
end

function UI:Hide()
	setMenuOpen(false)
end

function UI:Toggle()
	setMenuOpen(not menuOpen)
end

function UI:SetTitle(text)
	titleLabel.Text = tostring(text)
end

function UI:SetToggleKey(keyCode)
	assert(typeof(keyCode) == "EnumItem", "SetToggleKey expects an Enum.KeyCode value")
	self.ToggleKey = keyCode
	shortcutLabel.Text = string.upper(keyCode.Name) .. "  ·  HIDE"
end

function UI:Destroy()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)

	if screenGui.Parent then
		screenGui:Destroy()
	end
end

function UI:SelectCategory(category)
	if self.ActiveCategory == category then
		return
	end

	self.ActiveCategory = category

	for _, item in ipairs(self.Categories) do
		local active = item == category
		item.Page.Visible = active
		item.Indicator.Visible = active
		item.Button.TextColor3 = active and Theme.Text or Theme.MutedText
		tween(item.Button, 0.16, {
			BackgroundTransparency = active and 0.2 or 1,
			BackgroundColor3 = active and Theme.Control or Theme.Sidebar,
		})
	end
end

function UI:AddCategory(name)
	assert(type(name) == "string" and name ~= "", "Category name must be a non-empty string")

	for _, existing in ipairs(self.Categories) do
		assert(existing.Name ~= name, "Category already exists: " .. name)
	end

	emptyState.Visible = false

	local category = {
		Name = name,
		Sections = {},
	}

	local button = create("TextButton", {
		Name = name:gsub("%s+", "") .. "Category",
		Size = UDim2.new(1, 0, 0, 35),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = "   " .. name,
		TextColor3 = Theme.MutedText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
		Parent = tabList,
	})
	corner(button, 6)

	local indicator = create("Frame", {
		Name = "ActiveIndicator",
		Position = UDim2.fromOffset(0, 7),
		Size = UDim2.fromOffset(3, 21),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 5,
		Parent = button,
	})
	corner(indicator, 2)

	local page = create("ScrollingFrame", {
		Name = name:gsub("%s+", "") .. "Page",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(0, 0),
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.MutedText,
		ScrollBarImageTransparency = 0.35,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		ZIndex = 2,
		Parent = pages,
	})

	create("TextLabel", {
		Name = "PageTitle",
		Position = UDim2.fromOffset(19, 14),
		Size = UDim2.new(1, -38, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = name,
		TextColor3 = Theme.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
		Parent = page,
	})

	create("TextLabel", {
		Name = "Subtitle",
		Position = UDim2.fromOffset(19, 39),
		Size = UDim2.new(1, -38, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = "Custom controls",
		TextColor3 = Theme.MutedText,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
		Parent = page,
	})

	local leftColumn = create("Frame", {
		Name = "LeftColumn",
		Position = UDim2.fromOffset(19, 69),
		Size = UDim2.new(0.5, -27, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = page,
	})

	local rightColumn = create("Frame", {
		Name = "RightColumn",
		Position = UDim2.new(0.5, 7, 0, 69),
		Size = UDim2.new(0.5, -26, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = page,
	})

	local leftLayout = create("UIListLayout", {
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = leftColumn,
	})

	local rightLayout = create("UIListLayout", {
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = rightColumn,
	})

	local function refreshCanvas()
		local height = math.max(leftLayout.AbsoluteContentSize.Y, rightLayout.AbsoluteContentSize.Y)
		page.CanvasSize = UDim2.fromOffset(0, 69 + height + 20)
		leftColumn.Size = UDim2.new(leftColumn.Size.X.Scale, leftColumn.Size.X.Offset, 0, height)
		rightColumn.Size = UDim2.new(rightColumn.Size.X.Scale, rightColumn.Size.X.Offset, 0, height)
	end

	connect(leftLayout:GetPropertyChangedSignal("AbsoluteContentSize"), refreshCanvas)
	connect(rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"), refreshCanvas)

	category.Button = button
	category.Indicator = indicator
	category.Page = page
	category.LeftColumn = leftColumn
	category.RightColumn = rightColumn
	category.RefreshCanvas = refreshCanvas

	function category:Select()
		UI:SelectCategory(self)
	end

	function category:AddSection(sectionName, column)
		assert(type(sectionName) == "string" and sectionName ~= "", "Section name must be a non-empty string")

		local side = string.lower(tostring(column or "Left"))
		local parent = side == "right" and self.RightColumn or self.LeftColumn

		local sectionFrame = create("Frame", {
			Name = sectionName:gsub("%s+", "") .. "Section",
			Size = UDim2.new(1, 0, 0, 54),
			BackgroundColor3 = Theme.Section,
			BorderSizePixel = 0,
			ClipsDescendants = false,
			ZIndex = 3,
			Parent = parent,
		})
		corner(sectionFrame, 7)
		stroke(sectionFrame, Theme.Separator, 0.45)

		create("TextLabel", {
			Name = "Title",
			Position = UDim2.fromOffset(13, 10),
			Size = UDim2.new(1, -26, 0, 21),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = sectionName,
			TextColor3 = Theme.Text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 4,
			Parent = sectionFrame,
		})

		create("Frame", {
			Name = "Separator",
			Position = UDim2.fromOffset(13, 37),
			Size = UDim2.new(1, -26, 0, 1),
			BackgroundColor3 = Theme.Separator,
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = sectionFrame,
		})

		local content = create("Frame", {
			Name = "Content",
			Position = UDim2.fromOffset(10, 47),
			Size = UDim2.new(1, -20, 0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = sectionFrame,
		})

		local layout = create("UIListLayout", {
			Padding = UDim.new(0, 7),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = content,
		})

		connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
			content.Size = UDim2.new(1, -20, 0, layout.AbsoluteContentSize.Y)
			sectionFrame.Size = UDim2.new(1, 0, 0, 57 + layout.AbsoluteContentSize.Y)
			refreshCanvas()
		end)

		local section = {
			Name = sectionName,
			Instance = sectionFrame,
			Content = content,
		}

		function section:AddLabel(text)
			return addLabel(self.Content, text)
		end

		function section:AddButton(text, callback)
			return addButton(self.Content, text, callback)
		end

		function section:AddToggle(text, defaultValue, callback)
			return addToggle(self.Content, text, defaultValue, callback)
		end

		function section:AddSlider(text, minimum, maximum, defaultValue, callback)
			return addSlider(self.Content, text, minimum, maximum, defaultValue, callback)
		end

		table.insert(self.Sections, section)
		refreshCanvas()
		return section
	end

	connect(button.MouseEnter, function()
		if UI.ActiveCategory ~= category then
			tween(button, 0.14, {
				BackgroundColor3 = Theme.ControlHover,
				BackgroundTransparency = 0.3,
				TextColor3 = Theme.Text,
			})
		end
	end)

	connect(button.MouseLeave, function()
		if UI.ActiveCategory ~= category then
			tween(button, 0.14, {
				BackgroundColor3 = Theme.Sidebar,
				BackgroundTransparency = 1,
				TextColor3 = Theme.MutedText,
			})
		end
	end)

	connect(button.MouseButton1Click, function()
		UI:SelectCategory(category)
	end)

	table.insert(self.Categories, category)
	if #self.Categories == 1 then
		self:SelectCategory(category)
	end

	return category
end

